  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8877AA", "fontStyle": "italic" } },
    { "name": "Keywords and control flow", "scope": ["keyword", "keyword.control", "storage.modifier"], "settings": { "foreground": "#FF9900" } },
    { "name": "Declarations", "scope": ["storage", "storage.type"], "settings": { "foreground": "#CC99CC" } },
    { "name": "Operators and punctuation", "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#D9C8B4" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "markup.inline.raw"], "settings": { "foreground": "#99CC66" } },
    { "name": "String escapes and regex", "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"], "settings": { "foreground": "#66CCCC" } },
    { "name": "Numbers and constants", "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant"], "settings": { "foreground": "#66CCCC" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#FFCC66" } },
    { "name": "Types and classes", "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class"], "settings": { "foreground": "#9999FF" } },
    { "name": "Variables", "scope": ["variable", "support.variable", "meta.definition.variable"], "settings": { "foreground": "#FFCC99" } },
    { "name": "Parameters", "scope": ["variable.parameter", "meta.parameter"], "settings": { "foreground": "#EEBBEE" } },
    { "name": "Language variables", "scope": ["variable.language"], "settings": { "foreground": "#FF7777", "fontStyle": "italic" } },
    { "name": "Object keys", "scope": ["support.type.property-name", "meta.object-literal.key", "variable.other.property", "variable.other.object.property"], "settings": { "foreground": "#BBBBFF" } },
    { "name": "Tags", "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#FF9900" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#CC99CC" } },
    { "name": "Decorators", "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "#EEBBEE" } },
    { "name": "Markdown headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#FF9900", "fontStyle": "bold" } },
    { "name": "Markdown bold", "scope": ["markup.bold"], "settings": { "foreground": "#FFCC66", "fontStyle": "bold" } },
    { "name": "Markdown italic", "scope": ["markup.italic"], "settings": { "foreground": "#CC99CC", "fontStyle": "italic" } },
    { "name": "Links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#9999FF" } },
    { "name": "Quotes", "scope": ["markup.quote"], "settings": { "foreground": "#D9C8B4", "fontStyle": "italic" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#99CC66" } },
    { "name": "Diff deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#FF7777" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#9999FF" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF7777", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "namespace": "#9999FF",
    "class": "#9999FF",
    "enum": "#9999FF",
    "interface": "#9999FF",
    "struct": "#9999FF",
    "type": "#9999FF",
    "typeParameter": "#BBBBFF",
    "parameter": "#EEBBEE",
    "variable": "#FFCC99",
    "variable.readonly": "#66CCCC",
    "property": "#BBBBFF",
    "enumMember": "#66CCCC",
    "function": "#FFCC66",
    "method": "#FFCC66",
    "macro": "#FF9900",
    "decorator": "#EEBBEE"
  }
}
