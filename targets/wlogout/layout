{
    "label" : "lock",
    "action" : "sh -c '$HOME/.config/sway/scripts/lock.sh'",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend",
    "keybind" : "s"
}
{
    "label" : "logout",
    "action" : "swaymsg exit",
    "text" : "Log out",
    "keybind" : "e"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shut down",
    "keybind" : "p"
}
