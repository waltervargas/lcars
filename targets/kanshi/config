# Display profiles. kanshi applies the first profile whose outputs all match the
# connected displays, and re-applies it on hotplug. List outputs with:
#   swaymsg -t get_outputs
# Match an external display by "Make Model Serial" so the profile survives a
# change of port.

profile laptop {
    output eDP-1 enable scale 1 position 0,0
}

